# ==============================================================================
# InboxPilot — Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inboxpilot?schema=public

# Redis Configuration (BullMQ & Distributed Rate Limiting)
REDIS_URL=redis://localhost:6379

# Authentication & Session Security
JWT_SECRET=inboxpilot_jwt_secret_must_be_at_least_32_characters_long_for_production
SESSION_SECRET=inboxpilot_cookie_session_encryption_secret_key_random_32_chars

# Google OAuth 2.0 Credentials
# (Obtain from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Ethereal Email SMTP Credentials
# (If left empty, worker will automatically generate an ephemeral Ethereal test account on startup)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=
DEFAULT_FROM_EMAIL=scheduler@inboxpilot.local

# Worker & Scheduler Concurrency and Rate Limits
# Concurrency: Number of parallel jobs a single worker process pulls simultaneously from BullMQ
WORKER_CONCURRENCY=5

# Minimum send interval (in ms) per sender identity across all distributed workers
MIN_SEND_INTERVAL_MS=2000

# Distributed Hourly Rate Limit per sender identity
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:5000
