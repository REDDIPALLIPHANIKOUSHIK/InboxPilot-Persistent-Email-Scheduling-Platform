generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  name      String
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders   Sender[]
  campaigns Campaign[]
  emails    Email[]

  @@map("users")
}

model Sender {
  id                    String   @id @default(uuid())
  userId                String
  name                  String
  email                 String
  isDefault             Boolean  @default(false)
  hourlyLimit           Int      @default(200)
  minimumSendIntervalMs Int      @default(2000)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  emails    Email[]

  @@index([userId])
  @@map("senders")
}

model Campaign {
  id                   String   @id @default(uuid())
  userId               String
  senderId             String
  name                 String
  subject              String
  body                 String   @db.Text
  startAt              DateTime
  idempotencyKey       String?
  delayBetweenEmailsMs Int      @default(1000)
  hourlyLimit          Int      @default(200)
  status               String   @default("active") // active, completed, paused, cancelled
  totalEmails          Int      @default(0)
  sentCount            Int      @default(0)
  failedCount          Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender  Sender  @relation(fields: [senderId], references: [id], onDelete: Restrict)
  emails  Email[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([senderId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("campaigns")
}

model Email {
  id             String    @id @default(uuid())
  userId         String
  campaignId     String
  senderId       String
  recipientEmail String
  subject        String
  body           String    @db.Text
  scheduledAt    DateTime
  sentAt         DateTime?
  status         String    @default("scheduled") // scheduled, processing, sent, failed, cancelled
  idempotencyKey String    @unique
  bullmqJobId    String?
  attempts       Int       @default(0)
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender           Sender            @relation(fields: [senderId], references: [id], onDelete: Restrict)
  deliveryAttempts DeliveryAttempt[]

  @@index([userId])
  @@index([campaignId])
  @@index([senderId])
  @@index([status])
  @@index([scheduledAt])
  @@index([idempotencyKey])
  @@map("emails")
}

model DeliveryAttempt {
  id                String    @id @default(uuid())
  emailId           String
  attemptNumber     Int
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  status            String    // success, failed
  errorMessage      String?   @db.Text
  providerMessageId String?
  createdAt         DateTime  @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@map("delivery_attempts")
}

model OutboxMessage {
  id          String    @id @default(uuid())
  campaignId  String?
  emailId     String?
  jobId       String    @unique
  eventType   String    @default("SCHEDULE_EMAIL") // SCHEDULE_EMAIL, CANCEL_EMAIL
  payload     String    @db.Text
  delayMs     Int       @default(0)
  status      String    @default("pending") // pending, published, failed
  retryCount  Int       @default(0)
  lastError   String?   @db.Text
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("outbox_messages")
}
